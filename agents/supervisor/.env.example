# Supervisor Agent — Environment Variables
# Copy this file to .env and fill in the values

# Gemini API key (required — get from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# URLs of the remote A2A agents
# For local development (default):
CRYPTO_AGENT_URL=http://localhost:8001
RISK_AGENT_URL=http://localhost:8002

# For production (Cloud Run URLs):
# CRYPTO_AGENT_URL=https://crypto-specialist-XXXXX.us-central1.run.app
# RISK_AGENT_URL=https://risk-analyst-XXXXX.us-central1.run.app

# Vertex AI Memory Bank config (optional; persistent memory instead of in-memory)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
AGENT_ENGINE_ID=
