# Crypto Specialist Agent — Environment Variables
# Copy this file to .env and fill in the values

# Gemini API key (required — get from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# MCP Server URL (default: production Cloud Run URL)
# For local MCP server: http://localhost:8000/mcp
MCP_SERVER_URL=https://system-crypto-mcp-server-823002731253.us-central1.run.app/mcp

# Server configuration
PORT=8001
HOST=0.0.0.0
SERVICE_URL=http://localhost:8001

# Google Cloud Memory Bank Configuration (Optional, fallback to InMemory)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
AGENT_ENGINE_ID=
