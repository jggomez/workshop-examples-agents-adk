# Risk Analyst Agent — Environment Variables
# Copy this file to .env and fill in the values

# Gemini API key (required — get from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Server configuration
PORT=8002
HOST=0.0.0.0
SERVICE_URL=http://localhost:8002

# Google Cloud Memory Bank Configuration (Optional, fallback to InMemory)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
AGENT_ENGINE_ID=

